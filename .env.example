# Seu token do ngrok (pegue em https://dashboard.ngrok.com/get-started/your-authtoken)
NGROK_AUTHTOKEN=seu_token_aqui

# ID do seu projeto no Google Cloud (GCP)
GCP_PROJECT_ID=seu_project_id_aqui

# Credenciais JSON da sua Conta de Serviço (Service Account) do Google Cloud
# Exemplo (compacte o JSON em uma linha): {"type": "service_account", "project_id": "seu_projeto", "private_key_id": "...", "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n", "client_email": "...", "client_id": "...", "auth_uri": "...", "token_uri": "...", "auth_provider_x509_cert_url": "...", "client_x509_cert_url": "..."}
GCP_SERVICE_ACCOUNT_JSON=seu_json_compactado_aqui
